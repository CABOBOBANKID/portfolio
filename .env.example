# Neon Postgres connection string (server only)
DATABASE_URL=
# Random string, 32+ characters. Signs admin sessions and hashes visitor IPs.
SESSION_SECRET=
# Created automatically when you connect a Vercel Blob store to the project
BLOB_READ_WRITE_TOKEN=
# Public site address, no trailing slash (used by the sitemap)
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
# Optional: email notification for new enquiries via Resend
RESEND_API_KEY=
MAIL_FROM=
